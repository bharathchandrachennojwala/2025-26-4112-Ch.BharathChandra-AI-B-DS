    {
      "cell_type": "code",
      "source": [
        "import numpy as np\n",
        "A=np.array([[2,3],[3,4],[4,2]])\n",
        "B=np.array([[8,7],[9,6],[10,8]])\n",
        "P=np.array([5,5])\n",
        "cA=A.mean(axis=0)\n",
        "cB=B.mean(axis=0)\n",
        "dA=np.linalg.norm(P-cA)\n",
        "dB=np.linalg.norm(P-cB)\n",
        "if dA<dB:\n",
        "  print(\"Point belongs to cluster A\")\n",
        "else:\n",
        "  print(\"Point belongs to cluster B\")"
      ],
